# ZenMCP identity
CLIENT_ID=peltierpro
CLIENT_NAME="Peltier Pro"
PROVIDER_NAME="Zen Business Solutions"
SERVICE_NAME="ZenBiz PeltierPro Odoo MCP"
ACCESS_MODE=read-write-controlled
WEBSITE_URL="https://mcp-peltier-staging.up.railway.app/mcp"
ICON_URL=

# Keep ZenMCP as the application; enable the Peltier integration addon
PELTIER_ENABLED=true
MCP_PUBLIC_URL="https://mcp-peltier-staging.up.railway.app"

# Odoo
ODOO_URL="https://odoo-stg.peltierpro.com"
ODOO_DATABASE="odoo-stg.peltierpro.com"
ODOO_API_KEY="6d84509ac30abcae378aa36fe90d796bbbd922c9"

# MCP runtime (legacy Peltier names are accepted and mapped by ZenMCP config)
TRANSPORT="streamable-http"
HOST="0.0.0.0"
PORT="8000"
REQUEST_TIMEOUT_SECONDS="30"
MAX_RESULTS="50"
LOG_LEVEL="INFO"

# Odoo-backed OAuth
AUTH_ENABLED="true"
AUTH_RESOURCE_SERVER_URL="https://mcp-peltier-staging.up.railway.app/mcp"
AUTH_REQUIRED_SCOPES="odoo.read"
AUTH_CODE_TTL_SECONDS="300"
AUTH_ACCESS_TOKEN_TTL_SECONDS="3600"
AUTH_REFRESH_TOKEN_TTL_SECONDS="2592000"

# Tool permissions
PERMISSIONS_ENABLED="true"
PERMISSIONS_FILE="/app/config/permissions.yaml"
